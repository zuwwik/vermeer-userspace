diff --git a/src/drv-ssc-light.c b/src/drv-ssc-light.c
index 27c819f..d1b88fe 100644
--- a/src/drv-ssc-light.c
+++ b/src/drv-ssc-light.c
@@ -23,6 +23,39 @@ typedef struct DrvData {
 	gulong measurement_id;
 } DrvData;
 
+typedef struct {
+	SSCSensorLight *sensor;
+	GError *error;
+	gboolean done;
+} LightInit;
+
+static void
+light_init_ready (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	LightInit *init = user_data;
+	init->sensor = SSC_SENSOR_LIGHT (g_async_initable_new_finish (G_ASYNC_INITABLE (source), result, &init->error));
+	init->done = TRUE;
+}
+
+static SSCSensorLight *
+light_new_for_device (GUdevDevice *device, GError **error)
+{
+	const char *data_type = g_udev_device_get_property (device, "SSC_LIGHT_SENSOR_TYPE");
+	LightInit init = { 0 };
+
+	if (!data_type)
+		return ssc_sensor_light_new_sync (NULL, error);
+
+	/* Select a board's native rear ALS without reinterpreting raw front data. */
+	g_async_initable_new_async (SSC_TYPE_SENSOR_LIGHT, G_PRIORITY_DEFAULT, NULL,
+	                           light_init_ready, &init, SSC_SENSOR_DATA_TYPE, data_type, NULL);
+	while (!init.done)
+		g_main_context_iteration (NULL, TRUE);
+	if (init.error)
+		g_propagate_error (error, init.error);
+	return init.sensor;
+}
+
 static gboolean
 ssc_light_discover (GUdevDevice *device)
 {
