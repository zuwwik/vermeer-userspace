+static uint32_t apps_std_frename(void *data, const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	if (!inbufs[1].s || !inbufs[2].s ||
+	    ((const char *)inbufs[1].p)[inbufs[1].s-1] ||
+	    ((const char *)inbufs[2].p)[inbufs[2].s-1]) return AEE_EBADPARM;
+	return hexagonfs_rename(ctx->fds, ctx->rootfd, inbufs[1].p, inbufs[2].p) ? AEE_EFAILED : 0;
+}
+
+static uint32_t apps_std_fopen(void *data, const struct fastrpc_io_buffer *inbufs,
+			     struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	if (!inbufs[1].s || !inbufs[2].s ||
+	    ((const char *)inbufs[1].p)[inbufs[1].s-1] ||
+	    ((const char *)inbufs[2].p)[inbufs[2].s-1]) return AEE_EBADPARM;
+	int flags = file_mode(inbufs[2].p);
+	if (flags < 0) return AEE_EBADPARM;
+	int fd = hexagonfs_openat_mode(ctx->fds, ctx->rootfd, ctx->rootfd, inbufs[1].p, flags);
+	if (fd < 0) return AEE_EFAILED;
+	*(uint32_t *)outbufs[0].p = fd;
+	return 0;
+}
+
+static uint32_t apps_std_fwrite(void *data, const struct fastrpc_io_buffer *inbufs,
+			      struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
