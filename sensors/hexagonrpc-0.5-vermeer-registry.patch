+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, const char *name, const char *newname)
+{
+	char *old = strdup(name), *new = strdup(newname);
+	if (!old || !new) { free(old); free(new); return -ENOMEM; }
+	char *a = strrchr(old, '/'), *b = strrchr(new, '/');
+	const char *oldbase = a ? a + 1 : old, *newbase = b ? b + 1 : new;
+	if (!*oldbase || !*newbase || !strcmp(oldbase,".") || !strcmp(oldbase,"..") ||
+	    !strcmp(newbase,".") || !strcmp(newbase,"..")) { free(old); free(new); return -EINVAL; }
+	if (a) *a = 0;
+	if (b) *b = 0;
+	int src = hexagonfs_openat(fds, rootfd, rootfd, a && *old ? old : "/");
+	int dst = hexagonfs_openat(fds, rootfd, rootfd, b && *new ? new : "/");
+	int ret = src < 0 ? src : dst < 0 ? dst :
+		fds[src]->ops->rename ? fds[src]->ops->rename(fds[src], oldbase, fds[dst], newbase) : -EROFS;
+	if (src >= 0) hexagonfs_close(fds, src);
+	if (dst >= 0) hexagonfs_close(fds, dst);
+	free(old); free(new);
+	return ret;
