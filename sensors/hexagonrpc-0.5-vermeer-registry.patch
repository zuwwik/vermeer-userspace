+static int file_mode(const char *mode)
+{
+	int flags;
+	switch (*mode++) {
+	case 'r': flags = O_RDONLY; break;
+	case 'w': flags = O_WRONLY | O_CREAT | O_TRUNC; break;
+	case 'a': flags = O_WRONLY | O_CREAT | O_APPEND; break;
+	default: return -EINVAL;
+	}
+	bool plus = false, binary = false;
+	for (; *mode; mode++) {
+		if (*mode == '+' && !plus) { plus = true; flags = (flags & ~O_ACCMODE) | O_RDWR; }
+		else if (*mode == 'b' && !binary) binary = true;
+		else return -EINVAL;
+	}
+	return flags;
+}
