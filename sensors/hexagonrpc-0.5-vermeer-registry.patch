+	ssize_t ret = hexagonfs_write(ctx->fds, input[0], input[1], inbufs[1].p);
+	if (ret < 0) return AEE_EFAILED;
+	output[0] = ret;
+	output[1] = (size_t)ret < input[1];
+	return 0;
+}
